# Template for the app's secrets. Do NOT commit real keys.
#
# Local use:   copy this file to .streamlit/secrets.toml and fill in values
#              (secrets.toml is git-ignored).
# Streamlit Community Cloud: paste the same two lines (with real values)
#              into your app's Settings -> Secrets box instead.

# U.S. Census Bureau API key (free).
# Sign up at https://api.census.gov/data/key_signup.html — the key arrives
# by email and must be activated via the link in that email.
# Optional for light use (the API works without one, but is rate-limited).
CENSUS_API_KEY = "paste-your-census-key-here"

# Google Places API key.
# Google Cloud Console (https://console.cloud.google.com/):
#   1. Create/select a project and attach a billing account.
#   2. APIs & Services -> Library -> enable "Places API (New)".
#      (The legacy "Places API" is not used and can't be enabled on new projects.)
#   3. APIs & Services -> Credentials -> Create credentials -> API key.
#   4. Edit the key -> API restrictions -> restrict it to "Places API (New)".
#      Leave Application restrictions as "None": Streamlit Cloud calls from
#      changing server IPs, so IP/referrer restrictions will break it.
#   5. Optional: set a budget alert under Billing -> Budgets & alerts.
GOOGLE_PLACES_API_KEY = "paste-your-google-places-key-here"

# ---------------------------------------------------------------------------
# Contact tracker (optional). Without these, the tracker only lasts for the
# browser session. Setup steps are in README.md ("Contact tracker setup").
#
# URL of a Google Sheet shared (as Editor) with the service account's
# client_email below. The app creates a "tracker" tab in it.
TRACKER_SHEET_URL = "https://docs.google.com/spreadsheets/d/your-sheet-id/edit"

# Paste the fields from the service account's JSON key file. Keep the
# private_key on one line with literal \n sequences, exactly as in the JSON.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "rcc-tracker@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
